{
  "name": "community-library-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    },
    "sharp": "0.35.5",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "scripts": {
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && node scripts/verify-eslint-rules.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "api:types:generate": "node scripts/generate-openapi-types.mjs",
    "api:types:check": "node scripts/check-openapi-types.mjs",
    "build": "next build --webpack && node scripts/check-client-bundle.mjs",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:e2e": "../scripts/run-gate-with-log.sh frontend e2e -- ./scripts/run-gate-steps.sh e2e",
    "test:e2e:cross-browser": "../scripts/run-gate-with-log.sh frontend e2e-cross-browser -- ./scripts/run-gate-steps.sh e2e-cross-browser",
    "test:performance": "../scripts/run-gate-with-log.sh frontend performance -- ./scripts/run-gate-steps.sh performance",
    "audit:signatures": "npm audit signatures",
    "audit:high": "npm audit --audit-level=high",
    "check": "../scripts/run-gate-with-log.sh frontend check -- ./scripts/run-gate-steps.sh check"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-testing-library": "7.16.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
